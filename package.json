{
  "name": "ti84-basic-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A TI-84 / TI-84 Plus Silver Edition TI-BASIC interpreter with syntax checking and a calculator-style GUI",
  "scripts": {
